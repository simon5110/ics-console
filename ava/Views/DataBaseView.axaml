<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
             xmlns:vm="using:ava.ViewModels"
             x:DataType="vm:DataBaseViewModel"
             x:Class="ava.Views.DataBaseView"
             Background="#F5F6F8">

    <!-- 设计时 DataContext：只在 IDE 预览器生效，运行时忽略 -->
    <d:UserControl.DataContext>
        <vm:DataBaseViewModel />
    </d:UserControl.DataContext>

    <Grid ColumnDefinitions="280,*" Margin="10">

        <!-- ========== 左栏：数据库总览树 ========== -->
        <Border Grid.Column="0" Theme="{DynamicResource CardBorder}" Margin="0,0,10,0">
            <Grid RowDefinitions="Auto,Auto,*" Margin="12">

                <!-- 标题 + 新增/删除/刷新/导出 图标按钮 -->
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="数据库总览"
                               FontSize="15" FontWeight="Bold"
                               VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                        <Button Width="28" Height="28" Padding="0" Background="Transparent"
                                BorderThickness="0" HorizontalContentAlignment="Center">
                            <Path Data="{Binding PlusIcon}" Fill="#409EFF"
                                  Width="16" Height="16" Stretch="Uniform" />
                        </Button>
                        <Button Width="28" Height="28" Padding="0" Background="Transparent"
                                BorderThickness="0" HorizontalContentAlignment="Center">
                            <Path Data="{Binding DeleteIcon}" Fill="#F56C6C"
                                  Width="16" Height="16" Stretch="Uniform" />
                        </Button>
                        <Button Width="28" Height="28" Padding="0" Background="Transparent"
                                BorderThickness="0" HorizontalContentAlignment="Center">
                            <Path Data="{Binding RefreshIcon}" Fill="#909399"
                                  Width="16" Height="16" Stretch="Uniform" />
                        </Button>
                        <Button Width="28" Height="28" Padding="0" Background="Transparent"
                                BorderThickness="0" HorizontalContentAlignment="Center">
                            <Path Data="{Binding ExportIcon}" Fill="#909399"
                                  Width="16" Height="16" Stretch="Uniform" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- 搜索框 -->
                <Border Grid.Row="1" Margin="0,10" Height="32"
                        Background="#F5F6F8" CornerRadius="4">
                    <Grid ColumnDefinitions="Auto,*" Margin="8,0">
                        <Path Grid.Column="0" Data="{Binding SearchIcon}" Fill="#909399"
                              Width="15" Height="15" Stretch="Uniform"
                              VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Text="{Binding Keyword}"
                                 PlaceholderText="请输入需要查找的关键字"
                                 BorderThickness="0" Background="Transparent"
                                 FontSize="12" VerticalContentAlignment="Center" />
                    </Grid>
                </Border>

                <!-- 工厂-车间-工序 树 -->
                <TreeView Grid.Row="2"
                          ItemsSource="{Binding TreeNodes}"
                          Background="Transparent"
                          BorderThickness="0">
                    <!-- 将节点 VM 的 IsExpanded 双向绑定到 TreeViewItem -->
                    <TreeView.Styles>
                        <Style Selector="TreeViewItem" x:DataType="vm:TreeNodeVm">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                            <Setter Property="Padding" Value="0,3" />
                        </Style>
                    </TreeView.Styles>
                    <TreeView.DataTemplates>
                        <TreeDataTemplate x:DataType="vm:TreeNodeVm"
                                          ItemsSource="{Binding Children}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Path Data="{Binding Icon}" Fill="#FAAD14"
                                      Width="16" Height="16" Stretch="Uniform"
                                      VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Name}" FontSize="13"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </TreeDataTemplate>
                    </TreeView.DataTemplates>
                </TreeView>
            </Grid>
        </Border>

        <!-- ========== 右栏：工具条 + 台账表格 + 生命周期时间线 ========== -->
        <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto">

            <!-- 顶部工具条：搜索 + 新增/删除/导出 + 状态徽标 -->
            <Grid Grid.Row="0" Margin="0,0,0,10" ColumnDefinitions="220,*,Auto">

                <!-- 搜索框 -->
                <Border Grid.Column="0" Height="32" Background="White"
                        CornerRadius="4" BorderBrush="#DCDFE6" BorderThickness="1">
                    <Grid ColumnDefinitions="Auto,*" Margin="8,0">
                        <Path Grid.Column="0" Data="{Binding SearchIcon}" Fill="#909399"
                              Width="15" Height="15" Stretch="Uniform"
                              VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Text="{Binding SearchKeyword}"
                                 PlaceholderText="请输入需要查找的关键字"
                                 BorderThickness="0" Background="Transparent"
                                 FontSize="12" VerticalContentAlignment="Center" />
                    </Grid>
                </Border>

                <!-- 三个蓝色操作按钮 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                            Margin="10,0,0,0">
                    <Button Background="#409EFF" CornerRadius="4" Padding="14,6">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <Path Data="{Binding PlusIcon}" Fill="White"
                                  Width="14" Height="14" Stretch="Uniform" />
                            <TextBlock Text="新增" Foreground="White" FontSize="13" />
                        </StackPanel>
                    </Button>
                    <Button Background="#409EFF" CornerRadius="4" Padding="14,6">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <Path Data="{Binding DeleteIcon}" Fill="White"
                                  Width="14" Height="14" Stretch="Uniform" />
                            <TextBlock Text="删除" Foreground="White" FontSize="13" />
                        </StackPanel>
                    </Button>
                    <Button Background="#409EFF" CornerRadius="4" Padding="14,6">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <Path Data="{Binding ExportIcon}" Fill="White"
                                  Width="14" Height="14" Stretch="Uniform" />
                            <TextBlock Text="导出" Foreground="White" FontSize="13" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- 右上角绿色圆形状态徽标：延迟 / 健康分 -->
                <Border Grid.Column="2" Width="56" Height="56" CornerRadius="28"
                        Background="#52C41A" VerticalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="{Binding PerfMsText}"
                                   Foreground="White" FontSize="13" FontWeight="Bold"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding PerfQps}"
                                   Foreground="White" FontSize="11" Opacity="0.85"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 中部：设备台账 DataGrid -->
            <Border Grid.Row="1" Theme="{DynamicResource CardBorder}" Padding="10">
                <DataGrid ItemsSource="{Binding Equipments}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          GridLinesVisibility="Horizontal"
                          CanUserReorderColumns="False"
                          CanUserResizeColumns="True">
                    <!-- 勾选行整行蓝底高亮 -->
                    <DataGrid.Styles>
                        <Style Selector="DataGridRow" x:DataType="vm:EquipmentRowVm">
                            <Setter Property="Background" Value="{Binding RowBrush}" />
                        </Style>
                    </DataGrid.Styles>
                    <DataGrid.Columns>
                        <!-- 选择框 -->
                        <DataGridTemplateColumn Width="50" CanUserResize="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="vm:EquipmentRowVm">
                                    <CheckBox IsChecked="{Binding IsSelected}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <!-- 序号 -->
                        <DataGridTextColumn Header="序号" Width="80"
                                            Binding="{Binding Index}" />
                        <!-- 设备编号 -->
                        <DataGridTextColumn Header="设备编号" Width="*"
                                            Binding="{Binding Code}" />
                        <!-- 设备名称 -->
                        <DataGridTextColumn Header="设备名称" Width="*"
                                            Binding="{Binding Name}" />
                        <!-- 设备类型 -->
                        <DataGridTextColumn Header="设备类型" Width="*"
                                            Binding="{Binding Type}" />
                        <!-- 设备地址 -->
                        <DataGridTextColumn Header="设备地址" Width="*"
                                            Binding="{Binding Address}" />
                        <!-- 生产厂家 -->
                        <DataGridTextColumn Header="生产厂家" Width="*"
                                            Binding="{Binding Manufacturer}" />
                        <!-- 数量 -->
                        <DataGridTextColumn Header="数量" Width="*"
                                            Binding="{Binding Quantity}" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- 底部：设备全生命周期时间线 -->
            <Border Grid.Row="2" Theme="{DynamicResource CardBorder}"
                    Margin="0,10,0,0" Padding="20,16">
                <ItemsControl ItemsSource="{Binding TimelineStages}"
                              HorizontalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:TimelineStageVm">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{Binding Icon}" Fill="#909399"
                                      Width="22" Height="22" Stretch="Uniform"
                                      VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Name}" FontSize="13"
                                           Foreground="#606266" Margin="8,0,0,0"
                                           VerticalAlignment="Center" />
                                <!-- 阶段间灰色 › 连接符，最后一项不显示 -->
                                <TextBlock Text="›" FontSize="22" Foreground="#C0C4CC"
                                           Margin="20,0" VerticalAlignment="Center"
                                           IsVisible="{Binding ShowSeparator}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </Grid>
    </Grid>
</UserControl>
