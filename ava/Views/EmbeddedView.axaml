<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="900"
             xmlns:vm="using:ava.ViewModels"
             xmlns:myControls="clr-namespace:ava.MyControls"
             xmlns:lvc="using:LiveChartsCore.SkiaSharpView.Avalonia"
             x:DataType="vm:EmbeddedViewModel"
             x:Class="ava.Views.EmbeddedView"
             Background="#F5F6F8">

    <d:UserControl.DataContext>
        <vm:EmbeddedViewModel />
    </d:UserControl.DataContext>

    <UserControl.Styles>
        <!-- 电源开关：开启=绿，关闭=灰 -->
        <Style Selector="ToggleButton.powerBtn">
            <Setter Property="Foreground" Value="#BBBBBB" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#E0E0E0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="ToggleButton.powerBtn:checked">
            <Setter Property="Foreground" Value="#3AA55C" />
            <Setter Property="BorderBrush" Value="#3AA55C" />
        </Style>

        <!-- 急停按钮 -->
        <Style Selector="Button.estop">
            <Setter Property="CornerRadius" Value="32" />
            <Setter Property="Background" Value="#E54545" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="BorderBrush" Value="#C62828" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>

        <!-- 电源开关图标：随选中态变色 -->
        <Style Selector="ToggleButton.powerBtn Path">
            <Setter Property="Fill" Value="#BBBBBB" />
        </Style>
        <Style Selector="ToggleButton.powerBtn:checked Path">
            <Setter Property="Fill" Value="#3AA55C" />
        </Style>

        <!-- 模式按钮选中高亮 -->
        <Style Selector="ListBoxItem.modeItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#666" />
        </Style>
        <Style Selector="ListBoxItem.modeItem:selected">
            <Setter Property="Background" Value="#EEF4FF" />
            <Setter Property="BorderBrush" Value="#3B82F6" />
            <Setter Property="Foreground" Value="#1D4ED8" />
        </Style>
        <Style Selector="ListBoxItem.modeItem Path">
            <Setter Property="Fill" Value="#666" />
        </Style>
        <Style Selector="ListBoxItem.modeItem:selected Path">
            <Setter Property="Fill" Value="#1D4ED8" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer Padding="10" HorizontalScrollBarVisibility="Disabled">
        <ItemsControl ItemsSource="{Binding Motors}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:MotorUnit">
                    <Border Theme="{DynamicResource CardBorder}"
                            Padding="16" Margin="0,0,0,12" CornerRadius="12">

                        <Grid RowDefinitions="Auto,Auto">
                            <!-- 标题 -->
                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="Bold" />
                                    <TextBlock Text="· 嵌入式电机监控" Foreground="#999" FontSize="13"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>

                            <!-- 左控制 + 右曲线 -->
                            <Grid Grid.Row="1" ColumnDefinitions="1.45*,1*">

                                <!-- ===== 左：控制区 ===== -->
                                <Grid Grid.Column="0" RowDefinitions="Auto,Auto,Auto,Auto"
                                      Margin="0,0,16,0">

                                    <!-- 指示器行：开关/仪表/急停/温度/状态 -->
                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="16">

                                        <!-- 电机开关 -->
                                        <Border BorderBrush="#EEE" BorderThickness="1" CornerRadius="8"
                                                Padding="8" Background="#FAFAFA">
                                            <StackPanel Spacing="4" HorizontalAlignment="Center">
                                                <ToggleButton Classes="powerBtn"
                                                              Width="44" Height="44" CornerRadius="22"
                                                              Padding="0"
                                                              IsChecked="{Binding IsPowerOn}">
                                                    <Path Width="22" Height="22" Stretch="Uniform"
                                                          Data="M16.56,5.44L15.11,6.89C16.84,7.94 18,9.82 18,12A6,6 0 0,1 6,12C6,9.82 7.16,7.94 8.89,6.89L7.44,5.44C5.26,6.87 4,9.27 4,12A8,8 0 0,0 12,20A8,8 0 0,0 20,12C20,9.27 18.74,6.87 16.56,5.44M13,3H11V13H13V3Z" />
                                                </ToggleButton>
                                                <TextBlock Text="电机开关" FontSize="11" Foreground="#777"
                                                           HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Border>

                                        <!-- 圆形仪表（负载 %） -->
                                        <Border BorderBrush="#EEE" BorderThickness="1" CornerRadius="8"
                                                Padding="8" Background="#FAFAFA">
                                            <StackPanel Spacing="4" HorizontalAlignment="Center">
                                                <myControls:CircleProgress
                                                    Width="84" Height="84"
                                                    Minimum="0" Maximum="100"
                                                    Value="{Binding LoadPercent}"
                                                    StrokeThickness="9"
                                                    Foreground="#3AA55C"
                                                    BackgroundRing="#E5E6EB"
                                                    TextColor="#303133" />
                                                <TextBlock Text="负载" FontSize="11" Foreground="#777"
                                                           HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Border>

                                        <!-- 急停 -->
                                        <Border BorderBrush="#EEE" BorderThickness="1" CornerRadius="8"
                                                Padding="8" Background="#FAFAFA">
                                            <StackPanel Spacing="4" HorizontalAlignment="Center">
                                                <Button Classes="estop"
                                                        Width="60" Height="60"
                                                        Content="STOP"
                                                        FontSize="13"
                                                        Command="{Binding EmergencyStopCommand}" />
                                                <TextBlock Text="电机急停" FontSize="11" Foreground="#777"
                                                           HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Border>

                                        <!-- 温度 -->
                                        <Border BorderBrush="#EEE" BorderThickness="1" CornerRadius="8"
                                                Padding="10" Background="#FAFAFA" Width="96">
                                            <StackPanel Spacing="4" HorizontalAlignment="Center">
                                                <Path Width="22" Height="22" Stretch="Uniform"
                                                      HorizontalAlignment="Center"
                                                      Data="M15,13V5A3,3 0 0,0 12,2A3,3 0 0,0 9,5V13A5,5 0 0,0 12,18A5,5 0 0,0 15,13M12,4A1,1 0 0,1 13,5V12H11V5A1,1 0 0,1 12,4Z"
                                                      Fill="#E54545" />
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <TextBlock Text="{Binding Temperature}" FontSize="16" FontWeight="Bold" />
                                                    <TextBlock Text="°C" FontSize="12" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock Text="电机温度" FontSize="11" Foreground="#777"
                                                           HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Border>

                                        <!-- 状态 -->
                                        <Border BorderBrush="#EEE" BorderThickness="1" CornerRadius="8"
                                                Padding="10" Background="#FAFAFA" Width="96">
                                            <StackPanel Spacing="4" HorizontalAlignment="Center">
                                                <Path Width="22" Height="22" Stretch="Uniform"
                                                      HorizontalAlignment="Center"
                                                      Data="M8,5.14V18.86L19,12L8,5.14Z"
                                                      Fill="#3AA55C" />
                                                <TextBlock Text="{Binding StatusText}" FontSize="16"
                                                           FontWeight="Bold" Foreground="#3AA55C"
                                                           HorizontalAlignment="Center" />
                                                <TextBlock Text="电机状态" FontSize="11" Foreground="#777"
                                                           HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <!-- 滑动调节 + 设定速度 -->
                                    <Grid Grid.Row="1" ColumnDefinitions="80,*,Auto"
                                          Margin="0,16,0,0">
                                        <TextBlock Grid.Column="0" Text="滑动调节" Foreground="#666"
                                                   FontSize="13" VerticalAlignment="Center" />
                                        <Slider Grid.Column="1" Minimum="0"
                                                Maximum="{Binding MaxSpeed}"
                                                Value="{Binding TargetSpeed}"
                                                TickFrequency="1" IsSnapToTickEnabled="False"
                                                VerticalAlignment="Center" Margin="10,0" />
                                        <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                    VerticalAlignment="Center" Spacing="4">
                                            <TextBlock Text="设定速度 " FontSize="13" Foreground="#666" />
                                            <TextBlock Text="{Binding TargetSpeed}" FontSize="15" FontWeight="Bold" />
                                            <TextBlock Text=" / " FontSize="13" Foreground="#999" />
                                            <TextBlock Text="{Binding ActualSpeed}" FontSize="15" FontWeight="Bold" />
                                            <TextBlock Text=" m/min" FontSize="12" Foreground="#666" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- 精细调节 -->
                                    <Grid Grid.Row="2" ColumnDefinitions="80,Auto,Auto,Auto,*"
                                          Margin="0,14,0,0">
                                        <TextBlock Grid.Column="0" Text="精细调节" Foreground="#666"
                                                   FontSize="13" VerticalAlignment="Center" />
                                        <Button Grid.Column="1" Width="34" Height="34"
                                                CornerRadius="17" Padding="0" FontSize="18"
                                                Content="−"
                                                Command="{Binding FineMinusCommand}" />
                                        <TextBlock Grid.Column="2" Text="{Binding FineValue}"
                                                   FontSize="18" FontWeight="Bold"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Center" Width="40"
                                                   TextAlignment="Center" />
                                        <Button Grid.Column="3" Width="34" Height="34"
                                                CornerRadius="17" Padding="0" FontSize="18"
                                                Content="+"
                                                Command="{Binding FinePlusCommand}" />
                                        <TextBlock Grid.Column="4" Text="档位" Foreground="#999"
                                                   FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0" />
                                    </Grid>

                                    <!-- 运行模式 -->
                                    <Grid Grid.Row="3" ColumnDefinitions="80,*"
                                          Margin="0,16,0,0">
                                        <TextBlock Grid.Column="0" Text="运行模式" Foreground="#666"
                                                   FontSize="13" VerticalAlignment="Center" />
                                        <ListBox Grid.Column="1"
                                                 SelectedIndex="{Binding SelectedModeIndex}"
                                                 Background="Transparent"
                                                 BorderThickness="0" Padding="0">
                                            <ListBox.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ListBox.ItemsPanel>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:MotorMode">
                                                    <Border Classes="modeItem" Padding="10,8" CornerRadius="8"
                                                            Width="84">
                                                        <StackPanel Spacing="6" HorizontalAlignment="Center">
                                                            <Path Width="20" Height="20" Stretch="Uniform"
                                                                  HorizontalAlignment="Center"
                                                                  Data="{Binding Icon}" />
                                                            <TextBlock Text="{Binding Name}" FontSize="12"
                                                                       HorizontalAlignment="Center" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Grid>
                                </Grid>

                                <!-- ===== 右：实时曲线 ===== -->
                                <Border Grid.Column="1" BorderBrush="#EEE" BorderThickness="1"
                                        CornerRadius="10" Padding="10" Background="#FFFFFF">
                                    <Grid RowDefinitions="Auto,*">
                                        <Grid Grid.Row="0" Margin="0,0,0,6">
                                            <TextBlock Text="电机实时曲线" FontSize="14" FontWeight="Bold"
                                                       VerticalAlignment="Center" />
                                            <!-- 右上角延迟/帧率徽标 -->
                                            <Border HorizontalAlignment="Right"
                                                    CornerRadius="12" Padding="8,3"
                                                    Background="#E8F7EE" BorderBrush="#3AA55C"
                                                    BorderThickness="1" IsHitTestVisible="False">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <Ellipse Width="8" Height="8" Fill="#3AA55C" />
                                                    <TextBlock FontSize="11" Foreground="#2E7D43">
                                                        <Run Text="{Binding LatencyMs}" /> ms
                                                        ·
                                                        <Run Text="{Binding Fps}" /> FPS
                                                    </TextBlock>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                        <lvc:CartesianChart Grid.Row="1"
                                                            Series="{Binding Series}"
                                                            XAxes="{Binding XAxes}"
                                                            YAxes="{Binding YAxes}" />
                                    </Grid>
                                </Border>

                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </ScrollViewer>

</UserControl>
