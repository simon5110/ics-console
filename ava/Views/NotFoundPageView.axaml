<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="ava.Views.NotFoundPageView"
             xmlns:vm="using:ava.ViewModels"
             x:DataType="vm:NotFoundPageViewModel"
             >

    <d:UserControl.DataContext>
        <vm:NotFoundPageViewModel />
    </d:UserControl.DataContext>

    <StackPanel>
        
        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center" >404 页面丢失了</TextBlock>
    </StackPanel>
    
</UserControl>
