<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
             x:Class="ava.Views.OSView"
             xmlns:vm="using:ava.ViewModels"
             xmlns:lvc="using:LiveChartsCore.SkiaSharpView.Avalonia"
             x:DataType="vm:OSViewModel"
             Background="#F5F6F8">

    <!-- 设计时 DataContext：只在 IDE 预览器生效，运行时忽略 -->
    <d:UserControl.DataContext>
        <vm:OSViewModel />
    </d:UserControl.DataContext>

    <Grid RowDefinitions="Auto,Auto,*" Margin="10">

        <!-- ① 顶部：6个设备状态卡 -->
        <ItemsControl Grid.Row="0" ItemsSource="{Binding EquipmentCards}" Margin="0,0,0,10">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="6" ColumnSpacing="10" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:EquipmentCard">
                    <Border Theme="{DynamicResource CardBorder}" Padding="16,12">
                        <StackPanel Spacing="8" HorizontalAlignment="Center">
                            <!-- 圆形图标容器 -->
                            <Border Width="48" Height="48" CornerRadius="24">
                                <!-- <Path Data="{Binding IconGeometry}" -->
                                <!--       Fill="White" -->
                                <!--       Width="24" Height="24" -->
                                <!--       Stretch="Uniform" -->
                                <!--       HorizontalAlignment="Center" -->
                                <!--       VerticalAlignment="Center" /> -->
                                <Image Width="48" Height="48"  VerticalAlignment="Center" HorizontalAlignment="Center" Source="{Binding IconGeometry}"></Image>
                            </Border>
                            <!-- 设备名 -->
                            <TextBlock Text="{Binding Name}"
                                       HorizontalAlignment="Center"
                                       FontSize="13" FontWeight="Bold" />
                            <!-- 位置 -->
                            <TextBlock Text="{Binding Location}"
                                       HorizontalAlignment="Center"
                                       Foreground="#999" FontSize="11" />
                            <!-- 状态徽标 -->
                            <Border CornerRadius="10" Padding="10,2"
                                    Background="{Binding StatusBrush}"
                                    HorizontalAlignment="Center">
                                <TextBlock Text="{Binding StatusText}"
                                           Foreground="White" FontSize="11"
                                           HorizontalAlignment="Center" />
                            </Border>
                            
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- ② 中部：3个KPI面板 -->
        <ItemsControl Grid.Row="1" ItemsSource="{Binding KpiItems}" Margin="0,0,0,10">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="3" ColumnSpacing="10" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:KpiItem">
                    <Border Theme="{DynamicResource CardBorder}" Padding="16">
                        <Grid RowDefinitions="Auto,Auto,*,Auto">
                            <!-- 标题 + 菜单按钮 -->
                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="{Binding Title}"
                                               FontSize="14" FontWeight="Bold" />
                                    <TextBlock Text="{Binding SubTitle}"
                                               Foreground="#999" FontSize="11" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="···"
                                           FontSize="18" Foreground="#999"
                                           VerticalAlignment="Top" />
                            </Grid>
                            <!-- 大数值 -->
                            <TextBlock Grid.Row="1" Text="{Binding ValueText}"
                                       FontSize="32" FontWeight="Bold"
                                       Margin="0,8" />
                            <!-- sparkline 曲线 -->
                            <lvc:CartesianChart Grid.Row="2"
                                                Height="60"
                                                Series="{Binding SparkSeries}"
                                                XAxes="{Binding SparkXAxes}"
                                                YAxes="{Binding SparkYAxes}" />
                            <!-- 趋势徽标 -->
                            <Border Grid.Row="3" CornerRadius="10" Padding="10,2"
                                    Background="{Binding TrendBrush}"
                                    HorizontalAlignment="Left">
                                <TextBlock Text="{Binding TrendText}"
                                           Foreground="White" FontSize="11" />
                            </Border>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- ③ 底部：设备台账 DataGrid -->
        <Border Grid.Row="2" Theme="{DynamicResource CardBorder}" Padding="10">
            <DataGrid ItemsSource="{Binding LedgerRows}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      GridLinesVisibility="Horizontal"
                      CanUserReorderColumns="False"
                      CanUserResizeColumns="True">
                <DataGrid.Columns>
                    <!-- 序号 -->
                    <DataGridTextColumn Header="序号" Width="60" 
                                        Binding="{Binding Index}" />
                    <!-- 设备（图标+名称） -->
                    <DataGridTemplateColumn  Header="设备" Width="*" >
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="vm:LedgerRow">
                                <StackPanel Orientation="Horizontal" Spacing="8" Height="50"
                                            VerticalAlignment="Center" Margin="6,0">
                                    <Path Data="{Binding IconGeometry}"
                                          Fill="#5B8FF9"
                                          Width="20" Height="20"
                                          Stretch="Uniform" />
                                    <TextBlock Text="{Binding Name}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <!-- 设备分类 -->
                    <DataGridTextColumn Header="设备分类" Width="200"
                                        Binding="{Binding Category}" />
                    <!-- 设备位置 -->
                    <DataGridTextColumn Header="设备位置" Width="200"
                                        Binding="{Binding Location}" />
                    <!-- 投产日期 -->
                    <DataGridTextColumn Header="投产日期" Width="200"
                                        Binding="{Binding Date}" />
                    <!-- 当前状态（彩色徽标） -->
                    <DataGridTemplateColumn Header="当前状态" Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="vm:LedgerRow">
                                <Border CornerRadius="10" Height="20" Padding="40,2"
                                        Background="{Binding StatusBrush}"
                                        HorizontalAlignment="Center" >
                                    <TextBlock VerticalAlignment="Center" Text="{Binding StatusText}"
                                               Foreground="White" FontSize="11" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <!-- 当前寿命（进度条+百分比） -->
                    <DataGridTemplateColumn Header="当前寿命" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="vm:LedgerRow">
                                <StackPanel Orientation="Horizontal" Spacing="6"
                                            VerticalAlignment="Center" Margin="6,0">
                                    <ProgressBar Minimum="0" Maximum="100"
                                                 Value="{Binding Lifetime}"
                                                 Width="100" Height="8" />
                                    <TextBlock Text="{Binding Lifetime}"
                                               VerticalAlignment="Center" FontSize="11" />
                                    <TextBlock Text="%"
                                               VerticalAlignment="Center" FontSize="11" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
