<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
             x:Class="ava.Views.RealTimeView"
             xmlns:vm="using:ava.ViewModels"
             xmlns:lvc="using:LiveChartsCore.SkiaSharpView.Avalonia"
             x:DataType="vm:RealTimeViewModel"
             Background="#F5F6F8">

    <d:UserControl.DataContext>
        <vm:RealTimeViewModel />
    </d:UserControl.DataContext>

    <Grid RowDefinitions="1.15*,1*" Margin="10">

        <!-- ================= 上排：产量统计 + 订单状态 ================= -->
        <Grid Grid.Row="0" ColumnDefinitions="2*,*">

            <!-- ① 产量统计：面积折线图 -->
            <Border Grid.Column="0" Theme="{DynamicResource CardBorder}" Padding="16"
                    Margin="0,0,10,0">
                <Grid RowDefinitions="Auto,*">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="产量统计"
                                   FontSize="17" FontWeight="Bold"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="···" FontSize="20"
                                   Foreground="#999" VerticalAlignment="Top" />
                    </Grid>
                    <lvc:CartesianChart Grid.Row="1"
                                        Series="{Binding OutputSeries}"
                                        XAxes="{Binding OutputXAxes}"
                                        YAxes="{Binding OutputYAxes}" />
                </Grid>
            </Border>

            <!-- ② 订单状态：环形图 -->
            <Border Grid.Column="1" Theme="{DynamicResource CardBorder}" Padding="16"
                    Margin="10,0,0,0">
                <Grid RowDefinitions="Auto,*">

                    <!-- 标题 / 图例 / 右上角延迟徽标 -->
                    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
                        <TextBlock Grid.Column="0" Text="订单状态"
                                   FontSize="17" FontWeight="Bold"
                                   VerticalAlignment="Center" />
                        <!-- 图例 -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                    HorizontalAlignment="Left" Margin="24,0,0,0"
                                    VerticalAlignment="Center" Spacing="16">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <Ellipse Width="9" Height="9" Fill="#F5222D" />
                                <TextBlock Text="未完成" FontSize="12" Foreground="#606266" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <Ellipse Width="9" Height="9" Fill="#2E7D32" />
                                <TextBlock Text="已完成" FontSize="12" Foreground="#606266" />
                            </StackPanel>
                        </StackPanel>
                        <!-- 绿色圆形延迟徽标（压在卡片右上角） -->
                        <Border Grid.Column="2" Width="52" Height="52" CornerRadius="26"
                                Background="#52C41A" Margin="0,-20,-20,0"
                                HorizontalAlignment="Right">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="{Binding PerfMsText}"
                                           Foreground="White" FontSize="12" FontWeight="Bold"
                                           HorizontalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" Spacing="2"
                                            HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding PerfScore}"
                                               Foreground="White" FontSize="10" Opacity="0.9" />
                                    <Path Width="8" Height="8" Stretch="Uniform"
                                          Data="M21,7L9,19L3.5,13.5L4.91,12.09L9,16.17L19.59,5.59L21,7Z"
                                          Fill="White" Opacity="0.9" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- 环形图 + 中心 90% 灰圆 -->
                    <Grid Grid.Row="1">
                        <lvc:PieChart Series="{Binding OrderSeries}"
                                      InitialRotation="-90"
                                      LegendPosition="Hidden" />
                        <Border Width="150" Height="150" CornerRadius="75"
                                Background="#E2E3E6"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                IsHitTestVisible="False">
                            <TextBlock Text="{Binding OrderCompleteRate, StringFormat='{}{0}%'}"
                                       FontSize="34" FontWeight="Bold" Foreground="#111"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ================= 下排：技能发展 / 产量对比 / 班组TOP3 ================= -->
        <Grid Grid.Row="1" ColumnDefinitions="*,*,*" Margin="0,10,0,0">

            <!-- ③ 技能发展：雷达图 -->
            <Border Grid.Column="0" Theme="{DynamicResource CardBorder}" Padding="16"
                    Margin="0,0,10,0">
                <Grid RowDefinitions="Auto,*,Auto">
                    <!-- 标题 + 选择组员 -->
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="技能发展"
                                   FontSize="17" FontWeight="Bold"
                                   VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" Width="150"
                                  ItemsSource="{Binding MemberOptions}"
                                  SelectedIndex="{Binding SelectedMemberIndex}"
                                  HorizontalAlignment="Right" />
                    </Grid>

                    <!-- 雷达图 -->
                    <lvc:PolarChart Grid.Row="1"
                                    Series="{Binding SkillSeries}"
                                    AngleAxes="{Binding SkillAngleAxes}"
                                    RadiusAxes="{Binding SkillRadiusAxes}" />

                    <!-- A~E 数值明细 -->
                    <ItemsControl Grid.Row="2" ItemsSource="{Binding SkillLabels}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="5" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SkillLabelVm">
                                <Border BorderBrush="#EBEEF2" BorderThickness="1,0,0,0"
                                        Padding="0,4">
                                    <TextBlock Text="{Binding Display}" FontSize="12"
                                               Foreground="#303133" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

            <!-- ④ 产量对比图：渐变柱状图 -->
            <Border Grid.Column="1" Theme="{DynamicResource CardBorder}" Padding="16"
                    Margin="10,0">
                <Grid RowDefinitions="Auto,*,Auto">
                    <!-- 标题 + 选择类型 -->
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="产量对比图"
                                   FontSize="17" FontWeight="Bold"
                                   VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" Width="150"
                                  ItemsSource="{Binding TypeOptions}"
                                  SelectedIndex="{Binding SelectedTypeIndex}"
                                  HorizontalAlignment="Right" />
                    </Grid>

                    <!-- 柱状图 -->
                    <lvc:CartesianChart Grid.Row="1"
                                        Series="{Binding CompareSeries}"
                                        XAxes="{Binding CompareXAxes}"
                                        YAxes="{Binding CompareYAxes}" />

                    <!-- 最差 / 最好产量说明 -->
                    <Grid Grid.Row="2" ColumnDefinitions="*,*" Margin="0,4,0,0">
                        <StackPanel Grid.Column="0" HorizontalAlignment="Center" Spacing="2">
                            <TextBlock Text="周二" FontSize="14" FontWeight="Bold"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="本周最差产量" FontSize="12" Foreground="#909399"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                        <Border Grid.Column="1" BorderBrush="#EBEEF2" BorderThickness="1,0,0,0">
                            <StackPanel HorizontalAlignment="Center" Spacing="2">
                                <TextBlock Text="周五" FontSize="14" FontWeight="Bold"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="本周最好产量" FontSize="12" Foreground="#909399"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- ⑤ 班组 TOP3 排行榜 -->
            <Border Grid.Column="2" Theme="{DynamicResource CardBorder}" Padding="16"
                    Margin="10,0,0,0">
                <Grid RowDefinitions="Auto,*,Auto">
                    <!-- 标题 + 选择区域 -->
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="班组TOP3"
                                   FontSize="17" FontWeight="Bold"
                                   VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" Width="150"
                                  ItemsSource="{Binding RegionOptions}"
                                  SelectedIndex="{Binding SelectedRegionIndex}"
                                  HorizontalAlignment="Right" />
                    </Grid>

                    <!-- 排行列表 -->
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding TopTeams}"
                                  VerticalAlignment="Center">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:TopTeamVm">
                                <Border BorderBrush="#F0F1F4" BorderThickness="0,0,0,1"
                                        Padding="4,12">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <!-- 奖牌圆 -->
                                        <Border Grid.Column="0" Width="34" Height="34"
                                                CornerRadius="17"
                                                Background="{Binding MedalBrush}"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Rank}"
                                                       Foreground="White" FontSize="16"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                        <!-- 班组名 -->
                                        <TextBlock Grid.Column="1" Margin="12,0"
                                                   FontSize="14" FontWeight="SemiBold"
                                                   VerticalAlignment="Center">
                                            <Run Text="{Binding Name}" />
                                            <Run Text=" (" Foreground="#909399" />
                                            <Run Text="{Binding Code}" Foreground="#909399" />
                                            <Run Text=")" Foreground="#909399" />
                                        </TextBlock>
                                        <!-- 积分 -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="Points" FontSize="11"
                                                       Foreground="#909399"
                                                       HorizontalAlignment="Right" />
                                            <TextBlock FontSize="14" FontWeight="Bold"
                                                       HorizontalAlignment="Right">
                                                <Run Text="{Binding Points}" />
                                                <Run Text="/100" />
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 底部三个班级奖章 -->
                    <ItemsControl Grid.Row="2" ItemsSource="{Binding ClassBadges}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <StackPanel HorizontalAlignment="Center" Spacing="4">
                                    <Grid Width="44" Height="50">
                                        <!-- 左绶带 -->
                                        <Border Width="9" Height="20" Background="#D93F3F"
                                                CornerRadius="2" Margin="8,26,0,0"
                                                HorizontalAlignment="Left"
                                                RenderTransformOrigin="50%,0%">
                                            <Border.RenderTransform>
                                                <RotateTransform Angle="-18" />
                                            </Border.RenderTransform>
                                        </Border>
                                        <!-- 右绶带 -->
                                        <Border Width="9" Height="20" Background="#D93F3F"
                                                CornerRadius="2" Margin="0,26,8,0"
                                                HorizontalAlignment="Right"
                                                RenderTransformOrigin="50%,0%">
                                            <Border.RenderTransform>
                                                <RotateTransform Angle="18" />
                                            </Border.RenderTransform>
                                        </Border>
                                        <!-- 红色奖章圆 + 白星 -->
                                        <Border Width="40" Height="40" CornerRadius="20"
                                                Background="#F5564E"
                                                HorizontalAlignment="Center">
                                            <Path Width="20" Height="20" Stretch="Uniform"
                                                  Fill="White"
                                                  Data="M12 17.27L18.18 21L16.54 13.97L22 9.24L14.81 8.62L12 2L9.19 8.62L2 9.24L7.45 13.97L5.82 21L12 17.27Z" />
                                        </Border>
                                    </Grid>
                                    <TextBlock Text="{Binding}" FontSize="12" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
