<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:rockDrill.ViewModels"
             xmlns:myControls="clr-namespace:rockDrill.MyControls"
             mc:Ignorable="d" d:DesignWidth="1570" d:DesignHeight="740"
             x:Class="rockDrill.Views.DrillingView"
             x:DataType="vm:DrillingViewModel">

    <UserControl.Resources>
        <!-- 左侧四个视图按钮（竖向堆叠，选中高亮） -->
        <ControlTheme x:Key="ViewTabItem" TargetType="ListBoxItem">
            <Setter Property="Background" Value="#12212C" />
            <Setter Property="Foreground" Value="{DynamicResource JumboSub}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="Root" Background="{TemplateBinding Background}" CornerRadius="9"
                            Padding="0,18" TextElement.Foreground="{TemplateBinding Foreground}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalContentAlignment="Center"
                                          VerticalContentAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover /template/ Border#Root">
                <Setter Property="Background" Value="#1A3040" />
            </Style>
            <Style Selector="^:selected">
                <Setter Property="Background" Value="{DynamicResource JumboAccent}" />
                <Setter Property="Foreground" Value="#04121B" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
        </ControlTheme>
        <ControlTheme x:Key="ViewTabList" TargetType="ListBox" BasedOn="{StaticResource JumboListBase}">
            <Setter Property="ItemContainerTheme" Value="{StaticResource ViewTabItem}" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="8" />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
        </ControlTheme>
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- 数值文本 -->
        <Style Selector="TextBlock.num">
            <Setter Property="FontFamily" Value="Consolas, Menlo, monospace" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource JumboGreen}" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*" RowSpacing="8">

        <!-- ================= 页头 ================= -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <TextBlock Classes="page-title" Text="钻孔" />
                <Border Classes="tag info"><TextBlock Text="{Binding SelectedViewText}" /></Border>
                <Border Classes="tag"><TextBlock Text="{Binding DatasetText}" /></Border>
                <Border Classes="tag ok"><TextBlock Text="{Binding DoneProgressText}" /></Border>
                <Border Classes="tag warn" IsVisible="{Binding IsManualPlanning}">
                    <TextBlock Text="手动规划中" />
                </Border>
            </StackPanel>
            <TextBlock Grid.Column="1" Classes="dim" Text="{Binding StatusText}"
                       VerticalAlignment="Center" Margin="14,0" MaxLines="1" TextTrimming="CharacterEllipsis" />
            <Border Grid.Column="2" Classes="tag"><TextBlock Text="{Binding SelectedHoleText}" /></Border>
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="96,*,336" ColumnSpacing="10">

            <!-- ================= 视图切换 ================= -->
            <ListBox Grid.Column="0" Theme="{StaticResource ViewTabList}" VerticalAlignment="Stretch"
                     ItemsSource="{Binding Views}"
                     SelectedIndex="{Binding ViewModeIndex, Mode=TwoWay}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:ViewModeOptionVm">
                        <TextBlock Text="{Binding Header}" FontSize="15" HorizontalAlignment="Center" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- ================= 中：双臂作业条 + 掌子面图 ================= -->
            <Grid Grid.Column="1" RowDefinitions="Auto,*" RowSpacing="8">

                <ItemsControl Grid.Row="0" ItemsSource="{Binding Arms}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2" ColumnSpacing="8" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:DrillArmVm">
                            <Border Classes="card" Padding="12,10">
                                <StackPanel Spacing="8">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="Bold"
                                                   Foreground="{Binding Accent}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding PlanDepthText}" Classes="sub"
                                                   VerticalAlignment="Center" Margin="12,0,0,0" />
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                                            <Button Theme="{StaticResource JumboButton}" Content="−" Padding="9,2"
                                                    FontSize="14" Command="{Binding StepDepthCommand}" CommandParameter="-0.25" />
                                            <Button Theme="{StaticResource JumboButton}" Content="+" Padding="9,2"
                                                    FontSize="14" Command="{Binding StepDepthCommand}" CommandParameter="0.25" />
                                        </StackPanel>
                                    </Grid>
                                    <Grid ColumnDefinitions="Auto,*">
                                        <TextBlock Text="{Binding DepthText}" FontSize="15" FontWeight="SemiBold"
                                                   FontFamily="Consolas, Menlo, monospace"
                                                   Foreground="{Binding Accent}" VerticalAlignment="Center"
                                                   Margin="0,0,10,0" MinWidth="52" />
                                        <myControls:LevelBar Grid.Column="1" Height="10" VerticalAlignment="Center"
                                                             Value="{Binding DepthPercent}" Maximum="100"
                                                             FillBrush="{Binding Accent}" />
                                    </Grid>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Classes="dim" Text="{Binding StateText}" FontSize="11.5" />
                                        <TextBlock Grid.Column="1" Classes="dim" FontSize="11.5"
                                                   Text="{Binding CurrentHole.NoText, StringFormat='当前孔 No.{0}'}" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 掌子面图（四视图投影） -->
                <Border Grid.Row="1" Classes="card" Padding="5">
                    <Grid>
                        <myControls:HoleSceneCanvas
                            Section="{Binding Section}"
                            Holes="{Binding DisplayHoles}"
                            ViewMode="{Binding ViewMode}"
                            CurrentHole="{Binding CurrentHole}"
                            SelectedHole="{Binding SelectedHole, Mode=TwoWay}"
                            ArmMarks="{Binding ArmMarks}"
                            LeftInfoText="{Binding LeftInfoText}"
                            RightInfoText="{Binding RightInfoText}"
                            Revision="{Binding CanvasRevision}" />

                        <!-- 弹出面板：常用数据 / 钻机参数 / 钻孔模式 -->
                        <Border IsVisible="{Binding IsPanelOpen}"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Width="520" Background="#E60E1720" CornerRadius="12"
                                BorderBrush="{DynamicResource JumboAccentDeep}" BorderThickness="1"
                                BoxShadow="0 0 40 0 #88040A0E" Padding="16">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="{Binding PanelTitle}" FontSize="16" FontWeight="SemiBold"
                                               Foreground="{DynamicResource JumboText}" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Theme="{StaticResource JumboButton}" Content="关闭"
                                            Padding="12,4" FontSize="12.5" Command="{Binding ClosePanelCommand}" />
                                </Grid>
                                <Border Classes="hr" Margin="0,0,0,4" />
                                <ItemsControl ItemsSource="{Binding PanelRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:InfoRowVm">
                                            <Grid ColumnDefinitions="120,*,Auto" Margin="0,4">
                                                <TextBlock Text="{Binding Label}" FontSize="13"
                                                           Foreground="{DynamicResource JumboSub}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="13.5"
                                                           FontFamily="Consolas, Menlo, monospace"
                                                           Foreground="{DynamicResource JumboText}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Text="{Binding Note}" FontSize="11.5"
                                                           Foreground="{DynamicResource JumboDim}" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <StackPanel Spacing="8" IsVisible="{Binding IsModePanel}">
                                    <Border Classes="hr" Margin="0,2" />
                                    <TextBlock Classes="card-title" Text="作业模式" />
                                    <ListBox Theme="{StaticResource JumboPillList}"
                                             ItemsSource="{Binding DrillModes}"
                                             SelectedIndex="{Binding DrillModeIndex, Mode=TwoWay}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- ================= 右：规划 / 参数 / 单臂局部图 ================= -->
            <Grid Grid.Column="2" ColumnDefinitions="*,104" ColumnSpacing="8">
                <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="8">

                    <!-- 臂别 / 已规划孔数 / 隐藏 -->
                    <Border Grid.Row="0" Classes="card hi" Padding="10">
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <ListBox Theme="{StaticResource JumboPillList}"
                                         ItemsSource="{Binding Arms}"
                                         SelectedIndex="{Binding SelectedArmIndex, Mode=TwoWay}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:DrillArmVm">
                                            <TextBlock Text="{Binding Name}" FontSize="14" />
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <Button Grid.Column="1" Theme="{StaticResource JumboButton}"
                                        Content="{Binding HideText}" FontSize="13" Padding="12,6"
                                        Command="{Binding ToggleHideCommand}" />
                            </Grid>
                            <TextBlock Classes="sub" Text="{Binding PlannedText}" />
                        </StackPanel>
                    </Border>

                    <!-- 规划 / 执行按钮 -->
                    <Border Grid.Row="1" Classes="card" Padding="10">
                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto"
                              ColumnSpacing="8" RowSpacing="8">
                            <Button Theme="{StaticResource JumboButton}" HorizontalAlignment="Stretch"
                                    Padding="0,9" Content="{Binding ClearArmText}"
                                    Command="{Binding ClearArmCommand}" />
                            <Button Grid.Column="1" Theme="{StaticResource JumboButton}"
                                    HorizontalAlignment="Stretch" Padding="0,9" Content="清除上一孔"
                                    Command="{Binding ClearLastHoleCommand}" />
                            <Button Grid.Row="1" Theme="{StaticResource JumboPrimaryButton}"
                                    HorizontalAlignment="Stretch" Padding="0,9" Content="自动规划"
                                    Command="{Binding AutoPlanCommand}" />
                            <Button Grid.Row="1" Grid.Column="1" Theme="{StaticResource JumboButton}"
                                    HorizontalAlignment="Stretch" Padding="0,9"
                                    Content="{Binding ManualPlanText}" Command="{Binding ManualPlanCommand}" />
                            <Button Grid.Row="2" Theme="{StaticResource JumboButton}"
                                    HorizontalAlignment="Stretch" Padding="0,9"
                                    Content="{Binding ExecuteArmText}" Command="{Binding ExecuteArmCommand}" />
                            <Button Grid.Row="2" Grid.Column="1" Theme="{StaticResource JumboDangerButton}"
                                    HorizontalAlignment="Stretch" Padding="0,9" Content="停　止"
                                    Command="{Binding StopArmCommand}" />
                            <Button Grid.Row="3" Grid.ColumnSpan="2" Theme="{StaticResource JumboButton}"
                                    HorizontalAlignment="Stretch" Padding="0,9" Content="清除已钻完成孔"
                                    Command="{Binding ClearDoneHolesCommand}" />
                        </Grid>
                    </Border>

                    <!-- 双臂参数表 -->
                    <Border Grid.Row="2" Classes="card" Padding="10">
                        <StackPanel Spacing="4">
                            <Grid ColumnDefinitions="*,64,64,50" Margin="0,0,0,4">
                                <TextBlock Classes="dim" Text="实时参数" />
                                <TextBlock Grid.Column="1" Classes="dim" Text="左臂" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="2" Classes="dim" Text="右臂" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="3" Classes="dim" Text="单位" HorizontalAlignment="Right" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding ParamRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:DrillParamRowVm">
                                        <Grid ColumnDefinitions="*,64,64,50" Margin="0,3">
                                            <TextBlock Text="{Binding Label}" FontSize="13"
                                                       Foreground="{DynamicResource JumboSub}"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding LeftText}" Classes="num"
                                                       HorizontalAlignment="Right" />
                                            <TextBlock Grid.Column="2" Text="{Binding RightText}" Classes="num"
                                                       HorizontalAlignment="Right" />
                                            <TextBlock Grid.Column="3" Text="{Binding Unit}" FontSize="11"
                                                       Foreground="{DynamicResource JumboDim}"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- 单臂局部图（对应现场 HMI 右下角的“左 / 右”视图） -->
                    <Border Grid.Row="3" Classes="card" Padding="4" MinHeight="160">
                        <myControls:HoleSceneCanvas
                            Section="{Binding Section}"
                            Holes="{Binding LocalHoles}"
                            ViewMode="{Binding ViewMode}"
                            CurrentHole="{Binding SelectedArm.CurrentHole}"
                            Caption="{Binding LocalCaption}"
                            ShowDimensions="False"
                            ShowHoleLabels="False"
                            Revision="{Binding CanvasRevision}" />
                    </Border>

                    <TextBlock Grid.Row="4" Classes="dim" FontSize="11.5" TextWrapping="Wrap"
                               Text="规划：自动规划按「底板 → 周边 → 分层蛇形」分臂排序；手动规划时在图上依次点选炮孔即可入队。" />
                </Grid>

                <!-- 右侧竖排：常用数据 / 钻机参数 / 钻孔模式 / 自动凿岩 / 急停 -->
                <StackPanel Grid.Column="1" Spacing="8">
                    <Button Theme="{StaticResource JumboButton}" Content="常用数据" Padding="0,16"
                            Command="{Binding OpenPanelCommand}" CommandParameter="common" />
                    <Button Theme="{StaticResource JumboButton}" Content="钻机参数" Padding="0,16"
                            Command="{Binding OpenPanelCommand}" CommandParameter="machine" />
                    <Button Theme="{StaticResource JumboButton}" Content="钻孔模式" Padding="0,16"
                            Command="{Binding OpenPanelCommand}" CommandParameter="mode" />
                    <Button Theme="{StaticResource JumboPrimaryButton}" Content="{Binding AutoDrillText}"
                            Padding="0,18" FontSize="14.5" Command="{Binding ToggleAutoDrillCommand}" />
                    <Button Theme="{StaticResource JumboDangerButton}" Content="急　停" Padding="0,18"
                            FontSize="16" FontWeight="Bold" Command="{Binding EmergencyStopCommand}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
