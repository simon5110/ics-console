<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:rockDrill.ViewModels"
             xmlns:myControls="clr-namespace:rockDrill.MyControls"
             mc:Ignorable="d" d:DesignWidth="1570" d:DesignHeight="740"
             x:Class="rockDrill.Views.DrillingView"
             x:DataType="vm:DrillingViewModel">

    <UserControl.Styles>
        <Style Selector="TextBlock.k">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource JumboSub}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.v">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{DynamicResource JumboText}" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*" RowSpacing="12">

        <!-- ================= 页头 ================= -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <StackPanel Spacing="3">
                <TextBlock Classes="page-title" Text="钻孔控制" />
                <TextBlock Classes="sub" Text="单臂自动钻孔 · 工步联锁 · 防碰撞保护已启用" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Border Classes="tag warn"><TextBlock Text="{Binding AutoStateText}" /></Border>
                <Border Classes="tag ok"><TextBlock Text="水压联锁 OK" /></Border>
                <Border Classes="tag ok"><TextBlock Text="夹钎保护 OK" /></Border>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="292,*,300" ColumnSpacing="12">

            <!-- ================= 左：臂架 ================= -->
            <StackPanel Grid.Column="0" Spacing="12">
                <Border Classes="card">
                    <StackPanel Spacing="10">
                        <TextBlock Classes="card-title" Text="执行臂架" />
                        <ListBox Theme="{StaticResource JumboPillList}"
                                 ItemsSource="{Binding BoomOptions}"
                                 SelectedIndex="{Binding SelectedBoomIndex, Mode=TwoWay}" />
                        <Border Classes="hr" />
                        <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                            <TextBlock Classes="k" Text="掌子面距离" />
                            <TextBlock Classes="v" Text="3.86 m" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Classes="k" Text="定位偏差 X" />
                            <TextBlock Classes="v" Text="+0.012 m" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Classes="k" Text="定位偏差 Y" />
                            <TextBlock Classes="v" Text="-0.008 m" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Classes="k" Text="对孔方式" />
                            <TextBlock Classes="v" Text="激光 + 角度闭环" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Classes="card">
                    <StackPanel Spacing="9">
                        <TextBlock Classes="card-title" Text="臂架姿态" />
                        <ItemsControl ItemsSource="{Binding Axes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:AxisVm">
                                    <Grid ColumnDefinitions="68,*,62" Margin="0,5,0,0">
                                        <TextBlock Text="{Binding Label}" FontSize="13.5"
                                                   Foreground="{DynamicResource JumboSub}" VerticalAlignment="Center" />
                                        <myControls:LevelBar Grid.Column="1" Height="6" Margin="0,0,8,0"
                                                             Value="{Binding Percent}" Maximum="100"
                                                             FillBrush="{Binding Brush}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding ValueText}" FontSize="13"
                                                   FontFamily="Consolas, Menlo, monospace"
                                                   Foreground="{DynamicResource JumboText}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Classes="card flat">
                    <StackPanel Spacing="6">
                        <TextBlock Classes="card-title" Text="作业提示" />
                        <TextBlock Classes="dim" TextWrapping="Wrap"
                                   Text="推进压力超过 12 MPa 或回转压力波动 &gt; ±1.5 MPa 时，系统自动降速并提示夹钎风险。" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ================= 中：当前钻孔 ================= -->
            <Border Grid.Column="1" Classes="card">
                <Grid RowDefinitions="Auto,Auto,Auto,*">

                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Classes="card-title" Text="当前钻孔" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding HoleNoText}" FontSize="18" FontWeight="Bold"
                                       FontFamily="Consolas, Menlo, monospace"
                                       Foreground="{DynamicResource JumboAccent}" VerticalAlignment="Center" />
                            <Border Classes="tag info"><TextBlock Text="{Binding HoleTypeText}" /></Border>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Border Classes="tag"><TextBlock Text="自动模式" /></Border>
                            <Border Classes="tag warn"><TextBlock Text="钻入中" /></Border>
                        </StackPanel>
                    </Grid>

                    <!-- 孔深环 + 关键数据 -->
                    <Grid Grid.Row="1" ColumnDefinitions="Auto,*" Margin="0,14,0,0">
                        <Grid Width="152" Height="152">
                            <myControls:CircleProgress Width="152" Height="152" StrokeThickness="12"
                                                       Value="{Binding DepthPercent}"
                                                       ShowProgressText="False"
                                                       Foreground="{DynamicResource JumboAccent}"
                                                       BackgroundRing="{DynamicResource JumboTrack}"
                                                       TextColor="{DynamicResource JumboText}" />
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="0"
                                        Margin="0,26,0,0">
                                <TextBlock Text="孔深" FontSize="13" Foreground="{DynamicResource JumboDim}"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding DepthText}" FontSize="27" FontWeight="Bold"
                                           FontFamily="Consolas, Menlo, monospace"
                                           Foreground="{DynamicResource JumboText}" HorizontalAlignment="Center" />
                                <TextBlock Text="m" FontSize="13" Foreground="{DynamicResource JumboDim}"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Column="1" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" Margin="22,6,0,0"
                              ColumnSpacing="16" RowSpacing="16">
                            <StackPanel Spacing="3">
                                <TextBlock Classes="dim" Text="设计孔深" />
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="{Binding PlanDepthText}" FontSize="21" FontWeight="SemiBold"
                                               FontFamily="Consolas, Menlo, monospace"
                                               Foreground="{DynamicResource JumboText}" />
                                    <TextBlock Text="m" FontSize="13" Foreground="{DynamicResource JumboDim}"
                                               VerticalAlignment="Bottom" Margin="0,0,0,3" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="3">
                                <TextBlock Classes="dim" Text="已用时间" />
                                <TextBlock Text="{Binding ElapsedText}" FontSize="21" FontWeight="SemiBold"
                                           FontFamily="Consolas, Menlo, monospace"
                                           Foreground="{DynamicResource JumboText}" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Spacing="3">
                                <TextBlock Classes="dim" Text="预计剩余" />
                                <TextBlock Text="{Binding RemainText}" FontSize="21" FontWeight="SemiBold"
                                           FontFamily="Consolas, Menlo, monospace"
                                           Foreground="{DynamicResource JumboGreen}" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Spacing="3">
                                <TextBlock Classes="dim" Text="钻具编号" />
                                <TextBlock Text="T38-R32 / #07" FontSize="17" FontWeight="SemiBold"
                                           Foreground="{DynamicResource JumboText}" />
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <!-- 工步流程 -->
                    <Border Grid.Row="2" Background="#0B151D" CornerRadius="10" Padding="12,10" Margin="0,12,0,0">
                        <ItemsControl ItemsSource="{Binding Steps}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="6" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:StepVm">
                                    <StackPanel Spacing="6" HorizontalAlignment="Center">
                                        <Grid Width="26" Height="26">
                                            <Ellipse Fill="{Binding Brush}" Opacity="0.9" />
                                            <TextBlock Text="{Binding Index}" FontSize="13" FontWeight="Bold"
                                                       Foreground="#06121A" HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                        <TextBlock Text="{Binding Name}" FontSize="13"
                                                   Foreground="{DynamicResource JumboSub}" HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding StateText}" FontSize="12"
                                                   Foreground="{DynamicResource JumboDim}" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <!-- 钻进参数 -->
                    <StackPanel Grid.Row="3" Spacing="10" Margin="0,14,0,0">
                        <ItemsControl ItemsSource="{Binding Params}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3" Rows="2" ColumnSpacing="10" RowSpacing="10" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:MetricVm">
                                <Border Background="#101C25" BorderBrush="{DynamicResource JumboStroke}"
                                        BorderThickness="1" CornerRadius="9" Padding="10,8">
                                    <StackPanel Spacing="5">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="{Binding Label}" FontSize="14"
                                                       Foreground="{DynamicResource JumboSub}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Unit}" FontSize="12"
                                                       Foreground="{DynamicResource JumboDim}" />
                                        </Grid>
                                        <TextBlock Text="{Binding Display}" FontSize="21" FontWeight="Bold"
                                                   FontFamily="Consolas, Menlo, monospace"
                                                   Foreground="{DynamicResource JumboText}" />
                                        <myControls:LevelBar Height="6"
                                                             Value="{Binding Value}"
                                                             Minimum="{Binding Minimum}"
                                                             Maximum="{Binding Maximum}"
                                                             Target="{Binding Target}"
                                                             FillBrush="{Binding Brush}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Grid ColumnDefinitions="*,Auto" Margin="0,6,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Classes="card-title" Text="本循环已完成孔" VerticalAlignment="Center" />
                                <Border Classes="tag"><TextBlock Text="最近 3 孔" /></Border>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Classes="dim" Text="平均单孔 1 min 08 s"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <Border Background="#0B151D" CornerRadius="8" Padding="12,6">
                            <Grid ColumnDefinitions="70,*,*,88" Margin="0,4">
                                <TextBlock Classes="dim" Text="孔号" />
                                <TextBlock Grid.Column="1" Classes="dim" Text="孔深" />
                                <TextBlock Grid.Column="2" Classes="dim" Text="耗时" />
                                <TextBlock Grid.Column="3" Classes="dim" Text="结果" HorizontalAlignment="Right" />
                            </Grid>
                        </Border>

                        <ItemsControl ItemsSource="{Binding RecentHoles}" Margin="12,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:DrillRecordVm">
                                    <Grid ColumnDefinitions="70,*,*,88" Margin="0,5,0,5">
                                        <TextBlock Text="{Binding No}" FontSize="14"
                                                   FontFamily="Consolas, Menlo, monospace"
                                                   Foreground="{DynamicResource JumboText}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Depth}" FontSize="14"
                                                   FontFamily="Consolas, Menlo, monospace"
                                                   Foreground="{DynamicResource JumboSub}" />
                                        <TextBlock Grid.Column="2" Text="{Binding Duration}" FontSize="14"
                                                   FontFamily="Consolas, Menlo, monospace"
                                                   Foreground="{DynamicResource JumboSub}" />
                                        <TextBlock Grid.Column="3" Text="{Binding Result}" FontSize="14"
                                                   Foreground="{Binding Brush}" HorizontalAlignment="Right" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ================= 右：控制 / 联锁 ================= -->
            <StackPanel Grid.Column="2" Spacing="12">
                <Border Classes="card">
                    <StackPanel Spacing="9">
                        <TextBlock Classes="card-title" Text="操作控制" />
                        <Button Theme="{StaticResource JumboPrimaryButton}" HorizontalAlignment="Stretch"
                                Content="{Binding RunButtonText}"
                                Command="{Binding ToggleRunCommand}" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <Button Grid.Column="0" Theme="{StaticResource JumboButton}" Content="手动退钎"
                                    HorizontalAlignment="Stretch" />
                            <Button Grid.Column="1" Theme="{StaticResource JumboButton}" Content="单步点动"
                                    HorizontalAlignment="Stretch" />
                        </Grid>
                        <Button Theme="{StaticResource JumboButton}" Content="重置工步" HorizontalAlignment="Stretch" />
                        <Border Classes="hr" />
                        <Button Theme="{StaticResource JumboDangerButton}" Content="急　停" HorizontalAlignment="Stretch"
                                FontSize="17" FontWeight="Bold" Padding="0,12"
                                Command="{Binding EmergencyStopCommand}" />
                    </StackPanel>
                </Border>

                <Border Classes="card">
                    <StackPanel Spacing="9">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Classes="card-title" Text="联锁与保护" VerticalAlignment="Center" />
                            <Border Grid.Column="1" Classes="tag ok"><TextBlock Text="全部正常" /></Border>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Interlocks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:SignalVm">
                                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,5,0,5">
                                        <Ellipse Width="6" Height="6" Fill="{Binding Brush}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="14"
                                                   Foreground="{DynamicResource JumboSub}"
                                                   Margin="8,0,0,0" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding ValueText}" FontSize="13.5"
                                                   FontFamily="Consolas, Menlo, monospace"
                                                   Foreground="{DynamicResource JumboText}" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Classes="card flat">
                    <StackPanel Spacing="6">
                        <TextBlock Classes="card-title" Text="钻具寿命" />
                        <Grid ColumnDefinitions="*,Auto" Margin="0,2,0,0">
                            <TextBlock Classes="dim" Text="累计钻进" />
                            <TextBlock Grid.Column="1" Text="1 284 m" FontSize="14"
                                       Foreground="{DynamicResource JumboText}" />
                        </Grid>
                        <myControls:LevelBar Height="6" Value="64" Maximum="100"
                                             FillBrush="{DynamicResource JumboAmber}" />
                        <TextBlock Classes="dim" Text="建议剩余 320 m 后更换钎头" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
