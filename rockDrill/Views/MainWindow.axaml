<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:rockDrill.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1600" d:DesignHeight="900"
        x:Class="rockDrill.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="1600" Height="900"
        MinWidth="1280" MinHeight="760"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource JumboBackground}"
        Title="凿岩台车智能控制系统">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <DockPanel>

        <!-- ===================== 顶部状态栏 ===================== -->
        <Border DockPanel.Dock="Top" Height="58"
                Background="#0A1319"
                BorderBrush="{DynamicResource JumboStroke}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="18,0">

                <!-- 品牌 / 车型 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="11" VerticalAlignment="Center">
                    <Border Width="32" Height="32" CornerRadius="9">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                <GradientStop Offset="0" Color="#37C6FF" />
                                <GradientStop Offset="1" Color="#0E63A8" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="凿" FontSize="19" FontWeight="Bold" Foreground="#04121B"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center" Spacing="1">
                        <TextBlock Text="ICS · 凿岩台车智能控制系统" FontSize="17" FontWeight="SemiBold"
                                   Foreground="{DynamicResource JumboText}" />
                        <TextBlock Text="DW2-100 双臂凿岩台车  /  一号隧道 左线" FontSize="15"
                                   Foreground="{DynamicResource JumboDim}" />
                    </StackPanel>
                </StackPanel>

                <!-- 整车状态 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Classes="tag info">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse Width="6" Height="6" Fill="{DynamicResource JumboAccent}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding WorkStage}" />
                        </StackPanel>
                    </Border>
                    <Border Classes="tag ok">
                        <TextBlock Text="{Binding CanStatus}" />
                    </Border>
                    <Border Classes="tag ok">
                        <TextBlock Text="{Binding HydStatus}" />
                    </Border>
                    <Border Classes="tag">
                        <TextBlock Text="{Binding NetworkStatus}" />
                    </Border>
                    <Border Classes="tag">
                        <TextBlock Text="{Binding BatteryStatus}" />
                    </Border>
                </StackPanel>

                <!-- 报警 / 时间 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                    <Button Theme="{StaticResource JumboButton}" Padding="12,6" Command="{Binding GoAlarmCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Path Width="16" Height="16" Stretch="Uniform"
                                  Fill="{DynamicResource JumboAmber}"
                                  Data="M12 2.2a6.4 6.4 0 0 0-6.4 6.4v5.2L3.6 17h16.8l-2-3.2V8.6A6.4 6.4 0 0 0 12 2.2zM9.6 18.4h4.8a2.4 2.4 0 0 1-4.8 0z"
                                  VerticalAlignment="Center" />
                            <TextBlock Text="{Binding AlarmCount}" FontSize="17" Foreground="{DynamicResource JumboAmber}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="条未确认" FontSize="15" Foreground="{DynamicResource JumboSub}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Border Width="1" Height="26" Background="{DynamicResource JumboStroke}" />

                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding CurrentTime}" FontSize="21" FontWeight="SemiBold"
                                   FontFamily="Consolas, Menlo, monospace"
                                   Foreground="{DynamicResource JumboText}" HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding CurrentDate}" FontSize="15"
                                   Foreground="{DynamicResource JumboDim}" HorizontalAlignment="Right" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===================== 底部导航 ===================== -->
        <Border DockPanel.Dock="Bottom" Height="84"
                Background="#0A1319"
                BorderBrush="{DynamicResource JumboStroke}" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <TextBlock Grid.Column="0" Text="工作模式：半自动" FontSize="15"
                           Foreground="{DynamicResource JumboDim}" VerticalAlignment="Center"
                           Margin="18,0,0,0" />
                <ListBox Grid.Column="1" Name="NavList"
                         Theme="{StaticResource JumboNavList}"
                         ItemsSource="{Binding NavItems}"
                         SelectedItem="{Binding SelectedNav, Mode=TwoWay}"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="1" Margin="0,0,18,0">
                    <TextBlock Text="V2.4.1" FontSize="15" Foreground="{DynamicResource JumboDim}"
                               HorizontalAlignment="Right" />
                    <TextBlock Text="MES 在线" FontSize="15" Foreground="{DynamicResource JumboGreen}"
                               HorizontalAlignment="Right" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===================== 页面容器 ===================== -->
        <TransitioningContentControl Content="{Binding CurrentPage}" Margin="14,12,14,8">
            <TransitioningContentControl.PageTransition>
                <CrossFade Duration="0:0:0.18" />
            </TransitioningContentControl.PageTransition>
        </TransitioningContentControl>

    </DockPanel>
</Window>
